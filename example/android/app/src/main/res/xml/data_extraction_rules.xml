<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of this app goes to a cloud backup or to a new phone.
     Its data is the saved sign-in (encrypted with a Keystore key that is not
     copied, so a restored copy only fails to read), the call log (phone
     numbers) and the Vobiz push install id (a restored phone would take over
     this phone's push sign-up). Older Android: android:allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
