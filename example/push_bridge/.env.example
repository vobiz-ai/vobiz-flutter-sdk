# Copy this file to .env in the same folder and fill it in. .env is git-ignored.
# Environment variables of the same name win over this file.

# Port the bridge listens on. Point your tunnel at it.
PORT=8787

# This server's public HTTPS address, from your tunnel. For example, after
#   cloudflared tunnel --url http://localhost:8787
# it is the https://<random>.trycloudflare.com address cloudflared prints.
# A quick tunnel gets a new address each time: update this and restart.
PUBLIC_URL=

# Firebase service account key, used to send the push that wakes the app.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# It must belong to the same Firebase project as the app's google-services.json.
# An absolute path, or a path relative to this folder.
FIREBASE_SERVICE_ACCOUNT=

# Optional: on start-up, point your Vobiz number at this bridge. The bridge
# finds or creates the application named VOBIZ_APP_NAME, sets its answer and
# hangup URLs to PUBLIC_URL, and attaches the number if no other application
# has it. The Auth Token is also used to check the signature on every Vobiz
# webhook. Your account's Auth ID and Auth Token are on the Vobiz Console
# dashboard; the number is in E.164 form, e.g. +919876543210.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_NUMBER=
#VOBIZ_APP_NAME=Vobiz_Flutter_Push_Bridge
#FORCE_ATTACH=false        true moves the number here even if another application has it

# Optional tuning
#RING_SECONDS=45           how long a caller waits for the app before hearing "no answer"
#CALLER_ID_MODE=number     number: the app's SIP call shows your Vobiz number (as the web
#                          Playground does); caller: try to pass the real caller through
#SIP_HEADER_STYLE=suffix   how the call reference is written in <User sipHeaders>:
#                          suffix (RefX-VH=…) or plain (Ref=…). Vobiz's docs show both.
#VERIFY_SIGNATURES=true    false skips the Vobiz signature check (only when debugging)
#ALWAYS_RING=              endpoint usernames to ring even if no app has registered, comma separated
#BRIDGE_KEY=               the key the app sends; generated and saved in bridge-state.json if empty
