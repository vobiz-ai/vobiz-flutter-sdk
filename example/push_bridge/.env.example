# Copy this file to .env in the same folder and fill it in. .env is git-ignored.
# Environment variables of the same name win over this file.
#
# One setting per line, NAME=value, and every description on its own # line
# above its setting. To use an optional setting, remove the # in front of it.
# A value with a space in it must be quoted ("..."): the server refuses to
# start on an unquoted one, which is almost always a description left on the
# setting's line.
#
# Coming from the push version: FIREBASE_SERVICE_ACCOUNT and PUSH_WAIT_SECONDS
# are no longer read. Remove them, delete the Firebase service-account key
# file and revoke it in the Firebase console.

# Port the server listens on. Point your tunnel at it.
PORT=8787

# This server's public HTTPS address, from your tunnel. For example, after
#   cloudflared tunnel --url http://localhost:8787
# it is the https://<random>.trycloudflare.com address cloudflared prints.
# A quick tunnel gets a new address each time: update this and restart.
PUBLIC_URL=

# Your account's Auth ID and Auth Token (Vobiz Console dashboard) and your
# Vobiz number in E.164 form, e.g. +919876543210.
# Required: VOBIZ_AUTH_TOKEN signs every webhook, so the server will not start
# without it (or without PUBLIC_URL). VOBIZ_AUTH_ID is needed for access
# tokens, conferences, the connection watch and linking the number.
# On start-up the server points VOBIZ_NUMBER at itself: it finds or creates
# the application named VOBIZ_APP_NAME, sets its answer and hangup URLs to
# PUBLIC_URL, and attaches the number if no other application has it.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_NUMBER=
#VOBIZ_APP_NAME=Vobiz_Flutter_Push_Bridge
# true moves the number here even if another application has it.
#FORCE_ATTACH=false

# Who an inbound call rings. The server does not know which phones are signed
# in: it rings what ROUTES and ALWAYS_RING name, and with both empty it rings
# nobody.
# ROUTES: for each of your numbers, the SIP users to ring (endpoint usernames,
# or <sub>_<auth id> for an app signed in with an access token) and phone
# numbers (+ and digits), all at once in one Dial. For example:
#   ROUTES=+919876543210=alice;+918000000000=bob,carol,+919812345678
ROUTES=
# SIP users rung for every inbound call, whatever number was dialled, comma
# separated.
#ALWAYS_RING=

# How long the one Dial rings before the caller hears "no answer", 15 to 120
# seconds. Keep it at 35 or more: Vobiz holds a call for up to 30 seconds
# while its push wakes a closed app.
#RING_SECONDS=45
# number: the app's SIP call shows your Vobiz number (as the web Playground
# does). caller: try to pass the real caller through.
#CALLER_ID_MODE=number
# How the call reference is written in <User sipHeaders>: suffix (RefX-VH=...)
# or plain (Ref=...). Vobiz's docs show both.
#SIP_HEADER_STYLE=suffix

# Access tokens (POST /token). The sub minted when the app names none (the app
# signs in as <sub>_<auth id>), how long a token lasts (180 to 86400 seconds),
# and the application whose Answer URL handles the app's outbound calls. Without
# JWT_APP_ID the account's default application does, and where that does not
# work the registrar refuses the token (10001).
#JWT_SUB=flutter-app
#JWT_TTL_SECONDS=3600
#JWT_APP_ID=
# The other subs /token may mint, comma separated. Empty: any sub, for anyone
# with the bridge key, so a key holder can sign in as any user.
#JWT_ALLOWED_SUBS=agent42,agent43

# Connection watch, while the app reports during a call. Seconds without a
# report before the other party hears a beep (2 to 10).
#LOST_BEEP_SECONDS=3
# Seconds without a report before the call is ended (5 to 300; 0 never ends it).
#LOST_HANGUP_SECONDS=15
# Seconds after the app's last report before a conference it hosts is ended
# for everyone (1 to 300).
#CONF_HOST_LOST_SECONDS=2

# The key the app sends with every request (X-Bridge-Key): at least 16
# characters, no spaces. Empty: the server makes one and saves it in
# bridge-state.json. Anyone with it can mint tokens, manage any live call's
# conference and sign phones up for push: treat it like a password, and
# change it to cut every phone off.
#BRIDGE_KEY=

# The Vobiz API address. Change it only to test against another server.
#VOBIZ_API_URL=https://api.vobiz.ai

# true accepts webhooks without a Vobiz signature and lets the server start
# without PUBLIC_URL and VOBIZ_AUTH_TOKEN. Local experiments only.
#ALLOW_UNSIGNED_WEBHOOKS=false
